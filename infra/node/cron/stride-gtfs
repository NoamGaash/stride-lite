# ClickHouse reads S3 itself for SIRI, but it cannot open a multi-file zip, so
# the daily GTFS feed is one cron entry.
MAILTO=""
# cron's own PATH is /usr/bin:/bin, and clickhouse is in /usr/local/bin.
PATH=/usr/local/bin:/usr/bin:/bin
# flock because healing a long gap can outlast a day, and -n so the next day's
# run is skipped rather than queued behind it.
20 4 * * * root flock -n /var/lock/stride-gtfs -c 'cd /opt/stride-lite && CH_DB=stride CH_CLIENT="clickhouse client" ./ingest/gtfs.sh' >> /var/log/stride-gtfs.log 2>&1
