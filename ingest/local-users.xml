<!-- Six threads per query. The memory and I/O ceilings live in local.xml;
     this is the CPU one, and it is the difference between the machine staying
     usable and not. There is no server-wide CPU limit in ClickHouse, so it is
     set per profile. -->
<clickhouse>
    <profiles>
        <default>
            <max_threads>6</max_threads>
            <max_concurrent_queries_for_user>4</max_concurrent_queries_for_user>
        </default>
    </profiles>
    <users>
        <default>
            <password></password>
            <profile>default</profile>
            <quota>default</quota>
            <networks><ip>127.0.0.1</ip></networks>
            <access_management>1</access_management>
        </default>
    </users>
    <quotas><default></default></quotas>
</clickhouse>
