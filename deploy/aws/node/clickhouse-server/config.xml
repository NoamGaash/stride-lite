<clickhouse>
    <path>/var/lib/clickhouse/</path>
    <tmp_path>/var/lib/clickhouse/tmp/</tmp_path>
    <user_files_path>/var/lib/clickhouse/user_files/</user_files_path>
    <listen_host>127.0.0.1</listen_host>
    <tcp_port>9000</tcp_port>
    <http_port>8123</http_port>
    <logger><level>warning</level><log>/var/log/clickhouse-server/clickhouse.log</log></logger>
    <users_config>users.xml</users_config>
    <default_profile>default</default_profile>
    <!-- A trial of a t4g.small (2 GiB) on the t4g.medium (4 GiB), 2026-11-23:
         ClickHouse keeps to what it would have there, and a query past it
         fails with MEMORY_LIMIT_EXCEEDED instead of the kernel killing the
         server. Without it ClickHouse takes up to 90% of RAM. -->
    <max_server_memory_usage>1610612736</max_server_memory_usage>
    <!-- The mark cache counts against the limit above; its default is 5 GiB. -->
    <mark_cache_size>268435456</mark_cache_size>
</clickhouse>
