[Unit]
Description=SIRI requester: the current snapshot from the Ministry of Transport, to S3
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/stride-lite/node.env
StateDirectory=siri-requester
# Its timer is enabled only once OPEN_BUS_MOT_KEY is in node.env
# (deploy/aws/bin/install-node-config.sh).
ExecStart=/opt/stride-lite/deploy/aws/bin/siri-request.sh
# A run still going when the next one is due is hung; this ends it.
TimeoutStartSec=14

# It shares the node with ClickHouse. When memory runs out the kernel kills
# ClickHouse and not this, and under load each request still goes out on time.
OOMScoreAdjust=-1000
MemoryMin=64M
CPUWeight=1000
